# Copiá este archivo como .env y completá lo que uses:
#
#     cp .env.ejemplo .env
#
# El .env no se versiona. Los comandos (npm run web, npm run cm) lo leen solos;
# si no existe, arrancan igual con lo que esté configurado.

# ── IA ──────────────────────────────────────────────────────
# Sin esto funciona todo menos el plan de contenido y la sugerencia de identidad.
GEMINI_API_KEY=            # gratis en https://aistudio.google.com/app/apikey

# ── Bancos de fotos ─────────────────────────────────────────
# Todas gratuitas e instantáneas, sin tarjeta. Con una sola ya mejora bastante.
# Pexels es el mejor para consultas en castellano; empezá por ahí.
PEXELS_API_KEY=            # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=       # https://unsplash.com/developers
PIXABAY_API_KEY=           # https://pixabay.com/api/docs/
OPENVERSE_TOKEN=           # opcional: sube el cupo, ya funciona sin clave

# ── Servidor ────────────────────────────────────────────────
# CM_PORT=8787
# CM_HOST=127.0.0.1
# CM_TOKEN=                # obligatorio si CM_HOST no es localhost

# ── Tablero de valor ────────────────────────────────────────
# CM_PRECIO_PLACA=4
# CM_SIMBOLO=US$
# CM_MONEDA=USD
# CM_MODO_VALOR=equivalencia     # o "ahorro"
# CM_FUENTE_PRECIO=lo que cobra un diseñador por una placa suelta

# ── Firebase (Base de datos Firestore y Autenticación) ───────
# Obtené estas claves en https://console.firebase.google.com/
# 1. Creá un proyecto en Firebase.
# 2. En "Configuración del proyecto" -> "Tus apps" -> Web (</>), copiá los datos:
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Credenciales de Servicio para Backend (Opcional - Firebase Admin SDK)
# En "Configuración del proyecto" -> "Cuentas de servicio" -> "Generar nueva clave privada":
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── Otros ───────────────────────────────────────────────────
# CM_MODEL=gemini-2.0-flash
# CM_DATA=./data
# CM_TZ=America/Argentina/Buenos_Aires
