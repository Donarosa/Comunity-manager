# Copiá este archivo como .env y completá lo que uses:
#
#     cp .env.ejemplo .env
#
# El .env no se versiona. Los comandos (npm run web, npm run cm) lo leen solos;
# si no existe, arrancan igual con lo que esté configurado.

# ── IA ──────────────────────────────────────────────────────
# Sin esto funciona todo menos el plan de contenido y la sugerencia de identidad.
ANTHROPIC_API_KEY=

# ── Bancos de fotos ─────────────────────────────────────────
# Todas gratuitas e instantáneas, sin tarjeta. Con una sola ya mejora bastante.
# Pexels es el mejor para consultas en castellano; empezá por ahí.
PEXELS_API_KEY=            # https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=       # https://unsplash.com/developers
PIXABAY_API_KEY=           # https://pixabay.com/api/docs/
OPENVERSE_TOKEN=           # opcional: sube el cupo, ya funciona sin clave

# ── Servidor ────────────────────────────────────────────────
# CM_PORT=8787
# CM_HOST=127.0.0.1
# CM_TOKEN=                # obligatorio si CM_HOST no es localhost

# ── Tablero de valor ────────────────────────────────────────
# CM_PRECIO_PLACA=4
# CM_SIMBOLO=US$
# CM_MONEDA=USD
# CM_MODO_VALOR=equivalencia     # o "ahorro"
# CM_FUENTE_PRECIO=lo que cobra un diseñador por una placa suelta

# ── Otros ───────────────────────────────────────────────────
# CM_MODEL=claude-opus-5
# CM_DATA=./data
# CM_TZ=America/Argentina/Buenos_Aires
