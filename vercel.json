{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "core/**",
      "excludeFiles": "{data,placas,pruebas,content,capturas,.playwright-mcp,.claude,.vercel}/**"
    }
  },
  "rewrites": [
    {
      "source": "/admin/login",
      "destination": "/api"
    },
    {
      "source": "/admin/usuarios(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/analitica",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/config/(.*)",
      "destination": "/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/nucleo/(.*)",
      "destination": "/api"
    },
    {
      "source": "/salud",
      "destination": "/api"
    },
    {
      "source": "/catalogo",
      "destination": "/api"
    },
    {
      "source": "/cuentas(.*)",
      "destination": "/api"
    },
    {
      "source": "/imagenes/(.*)",
      "destination": "/api"
    },
    {
      "source": "/piezas/(.*)",
      "destination": "/api"
    },
    {
      "source": "/logos/buscar",
      "destination": "/api"
    },
    {
      "source": "/logotipos",
      "destination": "/logotipos.html"
    },
    {
      "source": "/logos",
      "destination": "/logos-visor.html"
    }
  ],
  "outputDirectory": "web"
}
